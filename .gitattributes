# ===== 行尾策略 =====
# 仓库默认 core.autocrlf=true（Windows 检出为 CRLF）。但打包进 fpk 的脚本
# 与配置会在飞牛（Linux）上被直接执行/解析，shebang 带上 \r 会报
# 「bad interpreter: No such file or directory」。因此这些文件必须始终以
# LF 检出与提交——即便在 Windows 上工作。
fpk/*.sh                    text eol=lf
fpk/cmd/**                  text eol=lf
fpk/wizard/**               text eol=lf
fpk/config/**               text eol=lf
fpk/manifest.tpl            text eol=lf
fpk/app/ui/config           text eol=lf
fpk/*.py                    text eol=lf
server/pkg/ai/ai_detect.py  text eol=lf
