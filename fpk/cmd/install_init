#!/bin/bash
# 安装前执行：检查运行依赖（ffmpeg / python3）

MISSING=""
command -v ffmpeg  >/dev/null 2>&1 || MISSING="${MISSING} ffmpeg"
command -v python3 >/dev/null 2>&1 || MISSING="${MISSING} python3"

# AI 识别的 Python 依赖：缺失时 worker 会在 import 阶段直接退出，
# 设置页「推理后端」只能显示未连接（历史版本显示「未知」）。
if command -v python3 >/dev/null 2>&1; then
    if ! python3 -c "import cv2" >/dev/null 2>&1; then
        MISSING="${MISSING} python3-opencv(cv2)"
    fi
    if ! python3 -c "import onnxruntime" >/dev/null 2>&1; then
        MISSING="${MISSING} python3-onnxruntime"
    fi
fi

if [ -n "${MISSING}" ]; then
    echo "CyanNVR 依赖缺失:${MISSING}；录像与 AI 检测将不可用。CPU：pip3 install opencv-python-headless onnxruntime；NVIDIA GPU 实测组合（Pascal 及以上）：pip3 install opencv-python-headless onnxruntime-gpu==1.18.1 numpy==1.26.4 nvidia-cudnn-cu11==8.9.6.50 nvidia-cublas-cu11 nvidia-cuda-runtime-cu11 nvidia-cuda-nvrtc-cu11 nvidia-cufft-cu11 nvidia-curand-cu11。安装后重启应用。" > "${TRIM_TEMP_LOGFILE}"
fi

exit 0
